{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "VELLUM_WERROR": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (Clang, ASan/UBSan, warnings as errors)",
            "inherits": "base",
            "binaryDir": "build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VELLUM_SANITIZERS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release (Clang, warnings as errors)",
            "inherits": "base",
            "binaryDir": "build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VELLUM_SANITIZERS": "OFF"
            }
        },
        {
            "name": "bench",
            "displayName": "Benchmark (Clang, optimized with debug info)",
            "inherits": "base",
            "binaryDir": "build/bench",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "VELLUM_SANITIZERS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "bench",
            "configurePreset": "bench"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "bench",
            "configurePreset": "bench",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
